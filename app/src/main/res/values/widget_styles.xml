<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.NothingCalendar.MonthWeekday" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">7sp</item>
    </style>

    <style name="Widget.NothingCalendar.MonthDay" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:autoSizeMaxTextSize">10sp</item>
        <item name="android:autoSizeMinTextSize">6sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:lineSpacingExtra">-3dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/widget_text_primary</item>
    </style>

    <style name="Widget.NothingCalendar.AgendaMeta" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:autoSizeMaxTextSize">9sp</item>
        <item name="android:autoSizeMinTextSize">7sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">8sp</item>
    </style>

    <style name="Widget.NothingCalendar.AgendaTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:autoSizeMaxTextSize">11sp</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text_primary</item>
    </style>
</resources>
