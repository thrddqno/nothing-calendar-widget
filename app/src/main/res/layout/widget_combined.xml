    <TextView
        android:id="@+id/combined_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_text_secondary"
        android:text="" />

    <TextView
        android:id="@+id/agenda_header"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:fontFamily="sans"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="@string/widget_combined_agenda_header"
        android:textColor="@color/widget_text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/agenda_row_0"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_accent_0"
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:layout_marginEnd="7dp"
            android:background="@color/widget_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_meta_0"
                style="@style/Widget.NothingCalendar.AgendaMeta"
                tools:text="09:00" />

            <TextView
