                    android:id="@+id/agenda_meta_4"
                    style="@style/Widget.NothingCalendar.AgendaMeta"
                    tools:text="9:00 AM" />

                <TextView
                    android:id="@+id/agenda_title_4"
                    style="@style/Widget.NothingCalendar.AgendaTitle"
                    tools:text="Team Sync" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agenda_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/agenda_accent_5"
                android:layout_width="3dp"
                android:layout_height="22dp"
                android:layout_marginEnd="7dp"
                android:background="@color/widget_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/agenda_meta_5"
                    style="@style/Widget.NothingCalendar.AgendaMeta"
                    tools:text="9:00 AM" />

                <TextView
                    android:id="@+id/agenda_title_5"
                    style="@style/Widget.NothingCalendar.AgendaTitle"
                    tools:text="Team Sync" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/agenda_empty_state"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_loading_compact"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/agenda_overflow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="14dp"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:ignore="SmallSp"
            tools:text="+3 MORE" />
    </LinearLayout>
</LinearLayout>
