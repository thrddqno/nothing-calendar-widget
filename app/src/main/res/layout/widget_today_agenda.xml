<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/widget_default_padding"
    tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/today_date_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="34"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/widget_space_sm"
        android:paddingEnd="@dimen/widget_space_sm">

        <TextView
            android:id="@+id/today_month"
            style="@style/Widget.NothingCalendar.Typography.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:maxLines="1"
            tools:text="NOV" />

        <TextView
            android:id="@+id/today_day"
            style="@style/Widget.NothingCalendar.Typography.Display"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:maxLines="1"
            tools:text="05" />

        <TextView
            android:id="@+id/today_weekday"
            style="@style/Widget.NothingCalendar.Typography.Weekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:maxLines="1"
            tools:text="THU" />
    </LinearLayout>

    <TextView
        android:id="@+id/today_divider"
        android:layout_width="@dimen/widget_divider_thickness"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/widget_space_md"
        android:layout_marginTop="@dimen/widget_space_md"
        android:layout_marginEnd="@dimen/widget_space_md"
        android:layout_marginBottom="@dimen/widget_space_md"
        android:background="@color/widget_divider"
        android:text="" />

    <LinearLayout
        android:id="@+id/today_agenda_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="65"
        android:orientation="vertical">

        <TextView
            android:id="@+id/agenda_header"
            style="@style/Widget.NothingCalendar.Typography.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="14dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_agenda_header"
            tools:ignore="SmallSp" />

        <LinearLayout
            android:id="@+id/agenda_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/agenda_accent_0"
                android:layout_width="@dimen/widget_event_accent_width"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/widget_event_content_gap_compact"
                android:background="@color/widget_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/agenda_meta_0"
                    style="@style/Widget.NothingCalendar.AgendaMeta"
                    tools:text="09:00–10:00" />

                <TextView
                    android:id="@+id/agenda_title_0"
                    style="@style/Widget.NothingCalendar.AgendaTitle"
                    tools:text="Team Sync" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agenda_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/agenda_accent_1"
                android:layout_width="@dimen/widget_event_accent_width"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/widget_event_content_gap_compact"
                android:background="@color/widget_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/agenda_meta_1"
                    style="@style/Widget.NothingCalendar.AgendaMeta"
                    tools:text="09:00–10:00" />

                <TextView
                    android:id="@+id/agenda_title_1"
                    style="@style/Widget.NothingCalendar.AgendaTitle"
                    tools:text="Team Sync" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agenda_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/agenda_accent_2"
                android:layout_width="@dimen/widget_event_accent_width"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/widget_event_content_gap_compact"
                android:background="@color/widget_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/agenda_meta_2"
                    style="@style/Widget.NothingCalendar.AgendaMeta"
                    tools:text="09:00–10:00" />

                <TextView
                    android:id="@+id/agenda_title_2"
                    style="@style/Widget.NothingCalendar.AgendaTitle"
                    tools:text="Team Sync" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agenda_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/agenda_accent_3"
                android:layout_width="@dimen/widget_event_accent_width"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/widget_event_content_gap_compact"
                android:background="@color/widget_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/agenda_meta_3"
                    style="@style/Widget.NothingCalendar.AgendaMeta"
                    tools:text="09:00–10:00" />

                <TextView
                    android:id="@+id/agenda_title_3"
                    style="@style/Widget.NothingCalendar.AgendaTitle"
                    tools:text="Team Sync" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/agenda_empty_state"
            style="@style/Widget.NothingCalendar.Typography.Status"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:text="@string/widget_loading_compact" />

        <TextView
            android:id="@+id/agenda_overflow"
            style="@style/Widget.NothingCalendar.Typography.Overflow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="12dp"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:visibility="gone"
            tools:ignore="SmallSp"
            tools:text="+2" />
    </LinearLayout>
</LinearLayout>
