<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    android:padding="6dp"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/agenda_header"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:fontFamily="sans"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="@string/widget_agenda_header"
        android:textColor="@color/widget_text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/agenda_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_accent_0"
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:background="@color/widget_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_meta_0"
                style="@style/Widget.NothingCalendar.AgendaMeta"
                tools:text="09:00" />

            <TextView
                android:id="@+id/agenda_title_0"
                style="@style/Widget.NothingCalendar.AgendaTitle"
                tools:text="Team Sync" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agenda_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_accent_1"
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:background="@color/widget_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_meta_1"
                style="@style/Widget.NothingCalendar.AgendaMeta"
                tools:text="09:00" />

            <TextView
                android:id="@+id/agenda_title_1"
                style="@style/Widget.NothingCalendar.AgendaTitle"
                tools:text="Team Sync" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agenda_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_accent_2"
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:background="@color/widget_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_meta_2"
                style="@style/Widget.NothingCalendar.AgendaMeta"
                tools:text="09:00" />

            <TextView
                android:id="@+id/agenda_title_2"
                style="@style/Widget.NothingCalendar.AgendaTitle"
                tools:text="Team Sync" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agenda_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_accent_3"
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:background="@color/widget_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_meta_3"
                style="@style/Widget.NothingCalendar.AgendaMeta"
                tools:text="09:00" />

            <TextView
                android:id="@+id/agenda_title_3"
                style="@style/Widget.NothingCalendar.AgendaTitle"
                tools:text="Team Sync" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/agenda_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/agenda_overflow"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:gravity="end|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="SmallSp"
        tools:text="+2 MORE" />

</LinearLayout>
