<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:orientation="vertical"
    android:padding="@dimen/widget_default_padding"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/agenda_header"
        style="@style/Widget.NothingCalendar.Typography.SectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="18dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/widget_agenda_header" />

    <LinearLayout
        android:id="@+id/agenda_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/widget_agenda_row_vertical_padding"
        android:paddingBottom="@dimen/widget_agenda_row_vertical_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_accent_0"
            android:layout_width="@dimen/widget_event_accent_width"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/widget_event_content_gap"
            android:background="@color/widget_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_meta_0"
                style="@style/Widget.NothingCalendar.AgendaMeta"
                tools:text="09:00" />

            <TextView
                android:id="@+id/agenda_title_0"
                style="@style/Widget.NothingCalendar.AgendaTitle"
                tools:text="Team Sync" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agenda_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/widget_agenda_row_vertical_padding"
        android:paddingBottom="@dimen/widget_agenda_row_vertical_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_accent_1"
            android:layout_width="@dimen/widget_event_accent_width"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/widget_event_content_gap"
            android:background="@color/widget_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_meta_1"
                style="@style/Widget.NothingCalendar.AgendaMeta"
                tools:text="09:00" />

            <TextView
                android:id="@+id/agenda_title_1"
                style="@style/Widget.NothingCalendar.AgendaTitle"
                tools:text="Team Sync" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agenda_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/widget_agenda_row_vertical_padding"
        android:paddingBottom="@dimen/widget_agenda_row_vertical_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_accent_2"
            android:layout_width="@dimen/widget_event_accent_width"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/widget_event_content_gap"
            android:background="@color/widget_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_meta_2"
                style="@style/Widget.NothingCalendar.AgendaMeta"
                tools:text="09:00" />

            <TextView
                android:id="@+id/agenda_title_2"
                style="@style/Widget.NothingCalendar.AgendaTitle"
                tools:text="Team Sync" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agenda_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/widget_agenda_row_vertical_padding"
        android:paddingBottom="@dimen/widget_agenda_row_vertical_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_accent_3"
            android:layout_width="@dimen/widget_event_accent_width"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/widget_event_content_gap"
            android:background="@color/widget_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_meta_3"
                style="@style/Widget.NothingCalendar.AgendaMeta"
                tools:text="09:00" />

            <TextView
                android:id="@+id/agenda_title_3"
                style="@style/Widget.NothingCalendar.AgendaTitle"
                tools:text="Team Sync" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/agenda_empty_state"
        style="@style/Widget.NothingCalendar.Typography.Status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_loading" />

    <TextView
        android:id="@+id/agenda_overflow"
        style="@style/Widget.NothingCalendar.Typography.Overflow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="14dp"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:visibility="gone"
        tools:ignore="SmallSp"
        tools:text="+2 MORE" />

</LinearLayout>
